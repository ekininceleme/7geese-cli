{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/exportOutput",
  "$defs": {
    "exportAnswer": {
      "properties": {
        "author": {
          "type": "string",
          "description": "Full name of the person who wrote this text"
        },
        "text": {
          "type": "string",
          "description": "The text"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "author",
        "text"
      ]
    },
    "exportBadge": {
      "properties": {
        "id": {
          "type": "string",
          "description": "Badge event ID"
        },
        "date": {
          "type": "string",
          "description": "Date the recognition was given (ISO 8601)"
        },
        "from": {
          "type": "string",
          "description": "Full name of the person who gave the badge"
        },
        "to": {
          "type": "string",
          "description": "Full name of the person who received the badge"
        },
        "badge": {
          "type": "string",
          "description": "Name of the badge awarded"
        },
        "message": {
          "type": "string",
          "description": "Personal message included with the badge"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "date"
      ]
    },
    "exportCheckin": {
      "properties": {
        "id": {
          "type": "string",
          "description": "Check-in ID"
        },
        "date": {
          "type": "string",
          "description": "Date the check-in was posted (ISO 8601)"
        },
        "author": {
          "type": "string",
          "description": "Full name of the person who posted the check-in"
        },
        "message": {
          "type": "string",
          "description": "Free-text update posted with this check-in"
        },
        "progress_at_checkin": {
          "type": "number",
          "description": "Objective progress percentage recorded at the time of this check-in"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "date"
      ]
    },
    "exportFeedbackAnswer": {
      "properties": {
        "question": {
          "type": "string",
          "description": "The question text"
        },
        "hint": {
          "type": "string",
          "description": "Guidance shown under the question"
        },
        "answer": {
          "type": "string",
          "description": "The answer: text or a number or the selected options"
        },
        "scale": {
          "type": "string",
          "description": "Range of a number answer if the question defines one"
        },
        "comments": {
          "items": {
            "$ref": "#/$defs/exportFeedbackComment"
          },
          "type": "array",
          "description": "Comments on the answer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "question",
        "answer"
      ]
    },
    "exportFeedbackComment": {
      "properties": {
        "author": {
          "type": "string",
          "description": "Full name of the person who wrote the comment. Absent if 7Geese hides the name"
        },
        "created": {
          "type": "string",
          "description": "Time the comment was written (ISO 8601)"
        },
        "text": {
          "type": "string",
          "description": "The comment text"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "created",
        "text"
      ]
    },
    "exportFeedbackRequest": {
      "properties": {
        "id": {
          "type": "integer",
          "description": "Feedback request ID"
        },
        "title": {
          "type": "string",
          "description": "Title of the feedback request"
        },
        "description": {
          "type": "string",
          "description": "Message of the feedback request"
        },
        "status": {
          "type": "string",
          "description": "Status that 7Geese gives for the recipient (for example DRAFT or IN_FLIGHT or COMPLETE)"
        },
        "requested_by": {
          "type": "string",
          "description": "Full name of the person who made the request"
        },
        "created": {
          "type": "string",
          "description": "Time the request was made (ISO 8601)"
        },
        "sent": {
          "type": "string",
          "description": "Time the request was sent (ISO 8601)"
        },
        "due": {
          "type": "string",
          "description": "Due time of the responses (ISO 8601)"
        },
        "asked": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Full names of the people who were asked for feedback. Only the names that 7Geese shows"
        },
        "asked_count": {
          "type": "integer",
          "description": "Number of people who were asked for feedback"
        },
        "responses_submitted": {
          "type": "integer",
          "description": "Number of responses that 7Geese reports as submitted"
        },
        "all_responses_visible": {
          "type": "boolean",
          "description": "False if 7Geese does not show all the responses to the session user. The responses list can then be incomplete"
        },
        "responses": {
          "items": {
            "$ref": "#/$defs/exportFeedbackResponse"
          },
          "type": "array",
          "description": "Responses that 7Geese shows to the session user"
        },
        "curated_report": {
          "$ref": "#/$defs/exportPeerReport",
          "description": "Curated report of the responses if one is available"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "title",
        "status",
        "created",
        "asked_count",
        "responses_submitted",
        "all_responses_visible",
        "responses"
      ]
    },
    "exportFeedbackResponse": {
      "properties": {
        "from": {
          "type": "string",
          "description": "Full name of the person who gave the feedback. Absent if 7Geese hides the name"
        },
        "submitted": {
          "type": "string",
          "description": "Time the response was submitted (ISO 8601). Absent if the response is not submitted"
        },
        "answers": {
          "items": {
            "$ref": "#/$defs/exportFeedbackAnswer"
          },
          "type": "array",
          "description": "Answers of this response"
        },
        "comments": {
          "items": {
            "$ref": "#/$defs/exportFeedbackComment"
          },
          "type": "array",
          "description": "Comments on the response"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "answers"
      ]
    },
    "exportKR": {
      "properties": {
        "id": {
          "type": "string",
          "description": "Key result ID"
        },
        "name": {
          "type": "string",
          "description": "Key result title"
        },
        "description": {
          "type": "string",
          "description": "Optional longer description"
        },
        "progress": {
          "type": "number",
          "description": "Completion percentage (0–100)"
        },
        "measurement_type": {
          "type": "string",
          "description": "How progress is measured: percent"
        },
        "starting_value": {
          "type": "number",
          "description": "Value at the start of the key result"
        },
        "current_value": {
          "type": "number",
          "description": "Current measured value"
        },
        "target_value": {
          "type": "number",
          "description": "Target value to reach 100% completion"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "name",
        "progress",
        "measurement_type",
        "starting_value",
        "current_value",
        "target_value"
      ]
    },
    "exportMeeting": {
      "properties": {
        "id": {
          "type": "string",
          "description": "1:1 meeting ID"
        },
        "date": {
          "type": "string",
          "description": "Scheduled date and time of the meeting (ISO 8601)"
        },
        "with": {
          "type": "string",
          "description": "Full name of the other participant"
        },
        "status": {
          "type": "string",
          "description": "Meeting status: completed"
        },
        "questions": {
          "items": {
            "$ref": "#/$defs/exportQA"
          },
          "type": "array",
          "description": "Questions and answers from the two participants. Only for completed meetings"
        },
        "comments": {
          "items": {
            "$ref": "#/$defs/exportAnswer"
          },
          "type": "array",
          "description": "Comments on the meeting. Only for completed meetings"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "date",
        "with",
        "status"
      ]
    },
    "exportNotification": {
      "properties": {
        "id": {
          "type": "string",
          "description": "Notification ID"
        },
        "date": {
          "type": "string",
          "description": "Date the notification was published (ISO 8601)"
        },
        "verb": {
          "type": "string",
          "description": "Type of the event"
        },
        "actor": {
          "type": "string",
          "description": "Display name of the person who caused the event"
        },
        "content": {
          "type": "string",
          "description": "Notification text. Can contain HTML"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "date"
      ]
    },
    "exportObjective": {
      "properties": {
        "id": {
          "type": "string",
          "description": "Objective ID"
        },
        "name": {
          "type": "string",
          "description": "Objective title"
        },
        "description": {
          "type": "string",
          "description": "Optional longer description of the objective"
        },
        "type": {
          "type": "string",
          "description": "Scope of the objective: personal"
        },
        "participant_type": {
          "type": "string",
          "description": "The role of the session user on this objective: owner"
        },
        "progress": {
          "type": "number",
          "description": "Overall completion percentage (0–100)"
        },
        "start_date": {
          "type": "string",
          "description": "Objective start date (YYYY-MM-DD)"
        },
        "due_date": {
          "type": "string",
          "description": "Objective due date (ISO 8601)"
        },
        "completed_date": {
          "type": "string",
          "description": "Date the objective was marked complete (ISO 8601)"
        },
        "closed": {
          "type": "boolean",
          "description": "Whether the objective is closed (completed or abandoned)"
        },
        "key_results": {
          "items": {
            "$ref": "#/$defs/exportKR"
          },
          "type": "array",
          "description": "Key results nested under this objective"
        },
        "checkins": {
          "items": {
            "$ref": "#/$defs/exportCheckin"
          },
          "type": "array",
          "description": "Full check-in history of the objective"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "name",
        "type",
        "progress",
        "closed"
      ]
    },
    "exportOutput": {
      "properties": {
        "exported_at": {
          "type": "string",
          "description": "ISO 8601 timestamp of when this export was generated"
        },
        "synced_at": {
          "type": "string",
          "description": "ISO 8601 timestamp of the oldest sync of the datasets in this export"
        },
        "me": {
          "$ref": "#/$defs/exportProfile",
          "description": "The profile and history of the exported user"
        },
        "direct_reports": {
          "items": {
            "$ref": "#/$defs/exportProfile"
          },
          "type": "array",
          "description": "Direct reports of the session user: profile"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "exported_at",
        "synced_at",
        "me"
      ]
    },
    "exportPeerQuestion": {
      "properties": {
        "question": {
          "type": "string",
          "description": "The peer feedback question text"
        },
        "answers": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Anonymised answers submitted by peers"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "question"
      ]
    },
    "exportPeerReport": {
      "properties": {
        "title": {
          "type": "string",
          "description": "Title of the peer feedback request"
        },
        "published": {
          "type": "string",
          "description": "Date the curated report was published (ISO 8601)"
        },
        "questions": {
          "items": {
            "$ref": "#/$defs/exportPeerQuestion"
          },
          "type": "array",
          "description": "Questions with anonymised peer answers"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "title"
      ]
    },
    "exportProfile": {
      "properties": {
        "profile": {
          "$ref": "#/$defs/exportUser",
          "description": "User profile information"
        },
        "objectives": {
          "items": {
            "$ref": "#/$defs/exportObjective"
          },
          "type": "array",
          "description": "OKRs where the user is an owner"
        },
        "reviews": {
          "items": {
            "$ref": "#/$defs/exportReview"
          },
          "type": "array",
          "description": "Performance reviews in all workflow states"
        },
        "feedback": {
          "items": {
            "$ref": "#/$defs/exportFeedbackRequest"
          },
          "type": "array",
          "description": "Feedback requests about the user with the responses. Newest first. Only for the session user"
        },
        "oneonones": {
          "items": {
            "$ref": "#/$defs/exportMeeting"
          },
          "type": "array",
          "description": "1:1 meeting history with questions and answers from the two participants. Only for the session user"
        },
        "recognitions": {
          "$ref": "#/$defs/exportRecognition",
          "description": "Recognition badges sent and received. Only for the session user"
        },
        "checkins": {
          "items": {
            "$ref": "#/$defs/exportUserCheckin"
          },
          "type": "array",
          "description": "Check-ins that the user posted"
        },
        "notifications": {
          "items": {
            "$ref": "#/$defs/exportNotification"
          },
          "type": "array",
          "description": "Notification feed"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "profile",
        "objectives",
        "reviews"
      ]
    },
    "exportQA": {
      "properties": {
        "question": {
          "type": "string",
          "description": "The question text"
        },
        "hint": {
          "type": "string",
          "description": "Optional guidance or sub-prompt shown under the question"
        },
        "answers": {
          "items": {
            "$ref": "#/$defs/exportAnswer"
          },
          "type": "array",
          "description": "Answers submitted by each participant"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "question",
        "answers"
      ]
    },
    "exportRecognition": {
      "properties": {
        "received": {
          "items": {
            "$ref": "#/$defs/exportBadge"
          },
          "type": "array",
          "description": "Badges the user received from others"
        },
        "given": {
          "items": {
            "$ref": "#/$defs/exportBadge"
          },
          "type": "array",
          "description": "Badges the user sent to others"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "received",
        "given"
      ]
    },
    "exportReview": {
      "properties": {
        "id": {
          "type": "integer",
          "description": "Performance review ID"
        },
        "title": {
          "type": "string",
          "description": "Name of the review cycle (e.g. 'Q1 2026 Performance Review')"
        },
        "period": {
          "type": "string",
          "description": "Shortest calendar period that contains the start and end dates: a quarter (Q1 2026)"
        },
        "start_date": {
          "type": "string",
          "description": "Review period start date (ISO 8601)"
        },
        "end_date": {
          "type": "string",
          "description": "Review period end date (ISO 8601)"
        },
        "state": {
          "type": "string",
          "description": "Workflow state: employee_input"
        },
        "position": {
          "type": "string",
          "description": "The user's job title at the time of the review"
        },
        "manager": {
          "type": "string",
          "description": "Full name of the user's manager for this review"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/exportReviewSection"
          },
          "type": "array",
          "description": "Review form sections containing questions and answers"
        },
        "peer_feedback": {
          "$ref": "#/$defs/exportPeerReport",
          "description": "Curated peer feedback report if one was published for this cycle"
        },
        "feedback_request_ids": {
          "items": {
            "type": "integer"
          },
          "type": "array",
          "description": "IDs of the feedback requests that are attached to this review. For the session user the requests and their responses are in the feedback section"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "title",
        "period",
        "start_date",
        "end_date",
        "state"
      ]
    },
    "exportReviewQA": {
      "properties": {
        "question": {
          "type": "string",
          "description": "The review question text"
        },
        "employee": {
          "type": "string",
          "description": "The answer of the reviewed user"
        },
        "manager": {
          "type": "string",
          "description": "The answer of the other responder"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "question"
      ]
    },
    "exportReviewSection": {
      "properties": {
        "title": {
          "type": "string",
          "description": "Section heading"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/exportReviewQA"
          },
          "type": "array",
          "description": "Questions and answers within this section"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "title",
        "items"
      ]
    },
    "exportUser": {
      "properties": {
        "id": {
          "type": "integer",
          "description": "7Geese user profile ID"
        },
        "name": {
          "type": "string",
          "description": "Full name"
        },
        "email": {
          "type": "string",
          "description": "Work email address"
        },
        "position": {
          "type": "string",
          "description": "Job title or position"
        },
        "hire_date": {
          "type": "string",
          "description": "Date the user joined the organisation (YYYY-MM-DD)"
        },
        "manager_id": {
          "type": "integer",
          "description": "7Geese user profile ID of the user's direct manager"
        },
        "manager": {
          "type": "string",
          "description": "Full name of the user's direct manager"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "name"
      ]
    },
    "exportUserCheckin": {
      "properties": {
        "id": {
          "type": "string",
          "description": "Check-in ID"
        },
        "date": {
          "type": "string",
          "description": "Date the check-in was posted (ISO 8601)"
        },
        "message": {
          "type": "string",
          "description": "Free-text update posted with this check-in"
        },
        "objective_id": {
          "type": "string",
          "description": "ID of the objective that the check-in is for"
        },
        "objective_name": {
          "type": "string",
          "description": "Title of the objective at the time of the check-in"
        },
        "progress_at_checkin": {
          "type": "number",
          "description": "Objective progress percentage recorded at the time of this check-in"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "date"
      ]
    }
  }
}
